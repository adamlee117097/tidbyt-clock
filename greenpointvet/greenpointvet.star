# --- end generated ---

def line(text, color):
    return render.Text(content = text, font = "tom-thumb", color = color)

def logo_frame(strip):
    return render.Column(
        children = [
            render.Row(
                children = [
                    render.Padding(pad = (1, 1, 1, 0), child = render.Image(src = base64.decode(ICON))),
                    render.Padding(
                        pad = (0, 3, 0, 0),
                        child = render.Column(
                            children = [
                                line("GREENPOINT", WHITE),
                                line("VETERINARY", GREEN),
                                line("HOSPITAL", GREEN),
                            ],
                        ),
                    ),
                ],
            ),
            render.Padding(pad = (0, 1, 0, 0), child = render.Image(src = base64.decode(strip))),
        ],
    )

ROTATION = ["sit", "catch", "yarn", "butterfly", "treat"]

def pick_scene(now):
    mins = now.hour * 60 + now.minute
    if mins < OPEN_HOUR * 60 + 30 or mins >= CLOSE_HOUR * 60 - 30:
        return "yawn"
    return ROTATION[(mins // 15) % len(ROTATION)]

def main(config):
    # `pixlet render ... state=asleep` (or awake) forces a card for previewing;
    # `scene=catch` (etc.) forces a daytime scene.
    now = time.now().in_location(TZ)
    state = config.str("state", "")
    if state in ("awake", "asleep"):
        awake = state == "awake"
    else:
        awake = now.hour >= OPEN_HOUR and now.hour < CLOSE_HOUR

    if awake:
        scene = config.str("scene", "")
        if scene not in DAY:
            scene = pick_scene(now)
        children = [logo_frame(f) for f in FRAMES] + [render.Image(src = base64.decode(f)) for f in DAY[scene]]
    else:
        children = [render.Image(src = base64.decode(f)) for f in NIGHT]
    return render.Root(delay = DELAY_MS, child = render.Animation(children = children))
