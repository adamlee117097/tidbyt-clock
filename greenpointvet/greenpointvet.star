# --- end generated ---

def line(text, color):
    return render.Text(content = text, font = "tom-thumb", color = color)

def logo_frame(strip):
    return render.Column(
        children = [
            render.Row(
                children = [
                    render.Padding(pad = (1, 1, 1, 0), child = render.Image(src = base64.decode(ICON))),
                    render.Padding(
                        pad = (0, 3, 0, 0),
                        child = render.Column(
                            children = [
                                line("GREENPOINT", WHITE),
                                line("VETERINARY", GREEN),
                                line("HOSPITAL", GREEN),
                            ],
                        ),
                    ),
                ],
            ),
            render.Padding(pad = (0, 1, 0, 0), child = render.Image(src = base64.decode(strip))),
        ],
    )

def main(config):
    children = [logo_frame(f) for f in STRIP] + [render.Image(src = base64.decode(f)) for f in SCENE]
    return render.Root(delay = DELAY_MS, child = render.Animation(children = children))
