"""Kaleidoscope Coffee -- two cartoon flamingos over a pair of espresso cups.

Frames are generated by make_frames.py; edit there and re-run. The scene is
picked here from the clock: while the shop is open it changes every 15
minutes (a stretch for the first and last half hour), and after closing the
birds sleep on one leg. Preview a scene with `pixlet render ... scene=sip`.
"""

load("render.star", "render")
load("encoding/base64.star", "base64")
load("time.star", "time")

DELAY_MS = 100
TZ = "America/New_York"
OPEN_HOUR = 8
CLOSE_HOUR = {"Mon": 17, "Tue": 17, "Wed": 17, "Thu": 17, "Fri": 18, "Sat": 18, "Sun": 18}
ROTATION = [
    "heart", "wave", "sip", "flaphop", "oneleg",
    "drowsy", "dance", "curious", "preen", "strut",
]

