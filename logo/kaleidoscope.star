# --- end generated ---

def pick(now):
    # format("Mon") is the only weekday accessor on a pixlet time
    close = CLOSE_HOUR.get(now.format("Mon"), OPEN_HOUR) * 60
    mins = now.hour * 60 + now.minute
    if mins < OPEN_HOUR * 60 or mins >= close:
        return "sleep"
    if mins < OPEN_HOUR * 60 + 30 or mins >= close - 30:
        return "stretch"
    return ROTATION[(mins // 15) % len(ROTATION)]

def main(config):
    scene = config.str("scene", "")
    state = config.str("state", "")
    if state == "asleep":
        scene = "sleep"
    if scene not in SCENES:
        scene = pick(time.now().in_location(TZ))
    return render.Root(
        delay = DELAY_MS,
        child = render.Animation(children = [render.Image(src = base64.decode(f)) for f in SCENES[scene]]),
    )
