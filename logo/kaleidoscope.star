WORDMARK_COLOR = "#B9B9B9"
WORDMARK_FONT = "CG-pixel-4x5-mono"
DELAY_MS = 66
TZ = "America/New_York"

OPEN_HOUR = 8
CLOSE_HOUR = {'Mon': 17, 'Tue': 17, 'Wed': 17, 'Thu': 17, 'Fri': 18, 'Sat': 18, 'Sun': 18}

